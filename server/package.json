{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "description": "APIRank Bun + Hono API server.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "bun test",
    "db:migrate": "bun src/db/migrate.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.7",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.11.9",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^26.4.0"
  }
}
