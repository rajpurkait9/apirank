{
  "name": "apirank",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source API quality, performance monitoring, observability, and AI optimization platform.",
  "license": "MIT",
  "packageManager": "bun@1.3.2",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "database/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2"
  }
}
