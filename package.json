{
  "name": "apirank",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source API quality, performance monitoring, observability, and AI optimization platform.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.2",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint . --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "db:migrate": "bun run --filter=server db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@biomejs/biome": "^2.5.10",
    "eslint": "^9.39.4",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2"
  }
}
